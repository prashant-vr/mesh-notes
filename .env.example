# Mesh Notes Configuration (.env)

# SMTP Email Configuration (For Email Verification)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Mesh Notes <no-reply@yourdomain.com>"

# Example for Sendgrid / Mailgun / Postmark / Amazon SES / Brevo:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM="Mesh Notes <no-reply@yourdomain.com>"

# Port override (optional, defaults to port.txt or 3000)
# PORT=3000

# SQLite database file path override (optional)
# DB_PATH=./data/mesh-notes.db
